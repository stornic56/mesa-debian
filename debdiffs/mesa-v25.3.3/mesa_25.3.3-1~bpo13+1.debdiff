+extern "C" {
+    pub fn sysctl(
+        name: *mut c_int,
+        namelen: c_int,
+        oldp: *mut c_void,
+        oldlenp: *mut size_t,
+        newp: *mut c_void,
+        newlen: size_t,
+    ) -> c_int;
