diff -Nru mesa-25.3.3/subprojects/libc-0.2.169/src/unix/bsd/freebsdlike/freebsd/freebsd13/x86_64.rs mesa-25.3.3/subprojects/libc-0.2.169/src/unix/bsd/freebsdlike/freebsd/freebsd13/x86_64.rs
