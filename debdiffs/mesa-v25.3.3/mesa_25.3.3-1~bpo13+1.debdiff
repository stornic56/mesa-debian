+                    .field("len", &self.len)
+                    .field("cmd", &self.cmd)
+                    .field("u", &self.u)
+                    .finish()
+            }
+        }
+
+        impl fmt::Debug for iwreq {
+            fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
+                f.debug_struct("iwreq")
+                    .field("ifr_ifrn", &self.ifr_ifrn)
+                    .field("u", &self.u)
+                    .finish()
+            }
+        }
+    }
+}
