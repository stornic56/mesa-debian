+#[must_use = "Iterators are lazy unless consumed"]
+pub struct ExtractIf<'a, K, F, A: Allocator = Global>
+where
+    F: FnMut(&K) -> bool,
+{
+    f: F,
+    inner: RawExtractIf<'a, (K, ()), A>,
+}
