+pub const NFSMNT_DEADTHRESH: c_int = 0x4000; // set dead server retry thresh
+pub const NFSMNT_NOAC: c_int = 0x8000; // disable attribute cache
+pub const NFSMNT_RDIRPLUS: c_int = 0x10000; // Use Readdirplus for V3
