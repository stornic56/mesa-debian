+    pub enum tpacket_versions {
+        TPACKET_V1,
+        TPACKET_V2,
+        TPACKET_V3,
+    }
+}
+
+s! {
+    pub struct glob_t {
+        pub gl_pathc: size_t,
+        pub gl_pathv: *mut *mut c_char,
