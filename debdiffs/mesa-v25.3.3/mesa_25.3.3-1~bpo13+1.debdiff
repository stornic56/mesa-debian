+commit 91f04dfe1d93b8d2d383999ff5faf6411961caa1
+Author: Ola x Nilsson <olani@axis.com>
+Date:   Fri Mar 17 09:54:34 2023 +0100
+
+    gnu: Handle basic file and time types for 32bit systems with time64
+    
+    32bit gnu types when _TIME_BITS=64 and _FILE_OFFSET_BITS=64
+
+diff --git a/src/unix/linux_like/linux/gnu/b32/mod.rs b/src/unix/linux_like/linux/gnu/b32/mod.rs
+index 54c84fa617..7cc9fb08e7 100644
