+
+pub type pmap = __c_anonymous_pmap;
+
+#[cfg_attr(feature = "extra_traits", derive(Debug))]
+pub enum sem {}
+impl Copy for sem {}
+impl Clone for sem {
+    fn clone(&self) -> sem {
+        *self
+    }
+}
