+// Portable GLOB_* flags are defined at the `linux_like` level.
+// The following are GNU extensions.
+pub const GLOB_PERIOD: c_int = 1 << 7;
+pub const GLOB_ALTDIRFUNC: c_int = 1 << 9;
+pub const GLOB_BRACE: c_int = 1 << 10;
