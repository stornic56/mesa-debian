+pub const NFSMNT_MAXGRPS: c_int = 0x20; // set maximum grouplist size
+pub const NFSMNT_INT: c_int = 0x40; // allow interrupts on hard mount
+pub const NFSMNT_NOCONN: c_int = 0x80; // Don't Connect the socket
