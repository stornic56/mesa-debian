+        policy: *mut c_int,
+    ) -> c_int;
+    pub fn cpuset_setdomain(
+        level: crate::cpulevel_t,
+        which: crate::cpuwhich_t,
+        id: crate::id_t,
+        setsize: size_t,
+        mask: *const crate::domainset_t,
+        policy: c_int,
+    ) -> c_int;
+
+    pub fn dirname(path: *mut c_char) -> *mut c_char;
+    pub fn basename(path: *mut c_char) -> *mut c_char;
+}
