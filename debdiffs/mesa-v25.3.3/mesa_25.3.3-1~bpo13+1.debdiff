+        /// Unused (just here for alignment).
+        pub ki_spare_short2: c_short,
+        /// Groups.
+        pub ki_groups: [crate::gid_t; crate::KI_NGROUPS],
+        /// Virtual size.
+        pub ki_size: crate::vm_size_t,
+        /// Current resident set size in pages.
