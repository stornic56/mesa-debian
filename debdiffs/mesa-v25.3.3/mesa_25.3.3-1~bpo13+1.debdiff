diff -Nru mesa-25.3.3/subprojects/libc-0.2.169/src/unix/linux_like/linux/gnu/b64/x86_64/mod.rs mesa-25.3.3/subprojects/libc-0.2.169/src/unix/linux_like/linux/gnu/b64/x86_64/mod.rs
