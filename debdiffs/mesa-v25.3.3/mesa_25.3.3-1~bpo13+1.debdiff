+
+        pub const EPOLL_CLOEXEC: c_int = 0x80000;
+
+        pub const EFD_CLOEXEC: c_int = 0x80000;
+    }
+}
+cfg_if! {
+    if #[cfg(target_arch = "sparc")] {
+        pub const F_SETLK: c_int = 8;
+        pub const F_SETLKW: c_int = 9;
