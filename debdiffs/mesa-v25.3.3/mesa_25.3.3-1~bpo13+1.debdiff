+pub const REG_R14: c_int = 1;
+pub const REG_R15: c_int = 0;
diff -Nru mesa-25.3.3/subprojects/libc-0.2.169/src/unix/solarish/x86_common.rs mesa-25.3.3/subprojects/libc-0.2.169/src/unix/solarish/x86_common.rs
