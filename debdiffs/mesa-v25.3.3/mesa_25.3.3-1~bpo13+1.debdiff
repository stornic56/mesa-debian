+        id: crate::id_t,
+        setsize: size_t,
+        mask: *const crate::domainset_t,
+        policy: c_int,
+    ) -> c_int;
+
+    pub fn dirname(path: *mut c_char) -> *mut c_char;
+    pub fn basename(path: *mut c_char) -> *mut c_char;
+}
