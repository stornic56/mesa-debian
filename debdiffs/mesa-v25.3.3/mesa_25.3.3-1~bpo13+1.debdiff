+
+pub const SOMAXCONN: c_int = 128;
+
+pub const ST_RELATIME: c_ulong = 4096;
+
+pub const AF_NFC: c_int = PF_NFC;
+pub const BUFSIZ: c_int = 4096;
+pub const EDEADLOCK: c_int = EDEADLK;
