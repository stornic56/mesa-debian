diff -Nru mesa-25.3.3/subprojects/log-0.4.26/benches/value.rs mesa-25.3.3/subprojects/log-0.4.26/benches/value.rs
--- mesa-25.3.3/subprojects/log-0.4.26/benches/value.rs	1969-12-31 19:00:00.000000000 -0500
+++ mesa-25.3.3/subprojects/log-0.4.26/benches/value.rs	2006-07-23 20:21:28.000000000 -0500
@@ -0,0 +1,27 @@
+#![cfg(feature = "kv")]
+#![feature(test)]
+
+use log::kv::Value;
+
+#[bench]
+fn u8_to_value(b: &mut test::Bencher) {
+    b.iter(|| Value::from(1u8));
+}
+
+#[bench]
+fn u8_to_value_debug(b: &mut test::Bencher) {
+    b.iter(|| Value::from_debug(&1u8));
+}
+
+#[bench]
+fn str_to_value_debug(b: &mut test::Bencher) {
+    b.iter(|| Value::from_debug(&"a string"));
+}
+
+#[bench]
+fn custom_to_value_debug(b: &mut test::Bencher) {
+    #[derive(Debug)]
+    struct A;
+
+    b.iter(|| Value::from_debug(&A));
+}
