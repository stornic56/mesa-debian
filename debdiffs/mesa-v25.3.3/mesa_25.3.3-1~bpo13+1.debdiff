diff -Nru mesa-25.3.3/subprojects/unicode-ident-1.0.13/meson.build mesa-25.3.3/subprojects/unicode-ident-1.0.13/meson.build
--- mesa-25.3.3/subprojects/unicode-ident-1.0.13/meson.build	1969-12-31 19:00:00.000000000 -0500
+++ mesa-25.3.3/subprojects/unicode-ident-1.0.13/meson.build	2026-05-26 15:46:10.000000000 -0500
@@ -0,0 +1,9 @@
+project('unicode-ident', 'rust', version : '1.0.13', license : '(MIT or Apache-2.0) AND Unicode-DFS-2016)')
+
+lib = static_library(
+  'unicode_ident',
+  'src/lib.rs',
+  override_options : ['rust_std=2018', 'build.rust_std=2018'],
+  rust_abi : 'rust',
+  native : true,
+)
