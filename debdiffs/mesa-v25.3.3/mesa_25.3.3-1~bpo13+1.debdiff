+// Linux-specific fcntls
+pub const F_SETLEASE: c_int = 1024;
+pub const F_GETLEASE: c_int = 1025;
+pub const F_NOTIFY: c_int = 1026;
+pub const F_CANCELLK: c_int = 1029;
