+pub const YESSTR: crate::nl_item = 0x502;
+pub const NOSTR: crate::nl_item = 0x503;
+
+// Different than Gnu.
+pub const FILENAME_MAX: c_uint = 4095;
+
+pub const PRIO_PROCESS: c_int = 0;
+pub const PRIO_PGRP: c_int = 1;
