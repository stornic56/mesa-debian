+        result: *mut *mut crate::group,
+    ) -> c_int;
+    pub fn sigaltstack(ss: *const stack_t, oss: *mut stack_t) -> c_int;
+    pub fn sem_close(sem: *mut sem_t) -> c_int;
+    pub fn getdtablesize() -> c_int;
+    pub fn getgrnam_r(
+        name: *const c_char,
+        grp: *mut crate::group,
