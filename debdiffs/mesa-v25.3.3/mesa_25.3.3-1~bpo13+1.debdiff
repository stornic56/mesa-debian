+pub const SYS_seccomp: c_long = 383;
+pub const SYS_getrandom: c_long = 384;
+pub const SYS_memfd_create: c_long = 385;
+pub const SYS_bpf: c_long = 386;
+pub const SYS_execveat: c_long = 387;
