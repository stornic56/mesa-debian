diff -Nru mesa-25.3.3/subprojects/syn-2.0.98/src/expr.rs mesa-25.3.3/subprojects/syn-2.0.98/src/expr.rs
--- mesa-25.3.3/subprojects/syn-2.0.98/src/expr.rs	1969-12-31 19:00:00.000000000 -0500
+++ mesa-25.3.3/subprojects/syn-2.0.98/src/expr.rs	2006-07-23 20:21:28.000000000 -0500
