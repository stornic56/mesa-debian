diff -Nru mesa-25.3.3/subprojects/log-0.4.26/meson.build mesa-25.3.3/subprojects/log-0.4.26/meson.build
--- mesa-25.3.3/subprojects/log-0.4.26/meson.build	1969-12-31 19:00:00.000000000 -0500
+++ mesa-25.3.3/subprojects/log-0.4.26/meson.build	2026-05-26 15:46:07.000000000 -0500
@@ -0,0 +1,16 @@
+# Copyright © 2024 Google
+# SPDX-License-Identifier: MIT
+
+project('log', 'rust', version : '0.4.26', license : 'MIT OR Apache-2.0')
+
+lib = static_library(
+  'log',
+  'src/lib.rs',
+  override_options : ['rust_std=2021', 'build.rust_std=2021'],
+  rust_abi : 'rust',
+  native : true,
+)
+
+dep_log = declare_dependency(
+  link_with : [lib]
+)
