++++ b/src/unix/linux_like/linux/gnu/b32/mod.rs
+@@ -28,6 +28,16 @@ cfg_if! {
+         pub type fsfilcnt_t = u64;
+         pub type rlim_t = u64;
+         pub type blksize_t = i64;
++    } else if #[cfg(gnu_time64_abi)] {
++        pub type time_t = i64;
++        pub type suseconds_t = i32;
++        pub type ino_t = u64;
++        pub type off_t = i64;
++        pub type blkcnt_t = i64;
++        pub type fsblkcnt_t = u64;
++        pub type fsfilcnt_t = u64;
++        pub type rlim_t = u64;
++        pub type blksize_t = i32;
+     } else {
+         pub type time_t = i32;
+         pub type suseconds_t = i32;
diff -Nru mesa-25.3.3/subprojects/libc-0.2.169/debian/patches/time64-035-timex_t.patch mesa-25.3.3/subprojects/libc-0.2.169/debian/patches/time64-035-timex_t.patch
