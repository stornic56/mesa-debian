--- mesa-25.3.3/subprojects/quote-1.0.40/rust-toolchain.toml	1969-12-31 19:00:00.000000000 -0500
+++ mesa-25.3.3/subprojects/quote-1.0.40/rust-toolchain.toml	2006-07-23 20:21:28.000000000 -0500
@@ -0,0 +1,2 @@
